{
  "name": "@gooddealer/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./wire": "./src/wire/index.ts",
    "./account": "./src/account/index.ts",
    "./audit": "./src/audit/index.ts",
    "./devices": "./src/devices/index.ts",
    "./workspace": "./src/workspace/index.ts",
    "./execution-events": "./src/execution-events/index.ts",
    "./recovery": "./src/recovery/index.ts",
    "./connectors": "./src/connectors/index.ts",
    "./domain-providers": "./src/domain-providers/index.ts",
    "./workspace-observations/cloudflare-dns": "./src/workspace-observations/cloudflare-dns.ts",
    "./admin": "./src/admin/index.ts",
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "generate:target-installation-vectors": "esbuild scripts/generate-target-installation-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-target-installation-vectors.mjs && node /tmp/gooddealer-target-installation-vectors.mjs",
    "generate:desktop-authorization-vectors": "esbuild scripts/generate-desktop-authorization-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-authorization-vectors.mjs && node /tmp/gooddealer-authorization-vectors.mjs",
    "generate:native-cloud-corpus": "esbuild scripts/generate-native-cloud-wire-corpus.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-native-cloud-corpus.mjs && node /tmp/gooddealer-native-cloud-corpus.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate:forced-takeover-vectors": "esbuild scripts/generate-forced-takeover-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-forced-takeover-vectors.mjs && node /tmp/gooddealer-forced-takeover-vectors.mjs",
    "generate:afternic-listing-write-evidence-vectors": "esbuild scripts/generate-afternic-listing-write-evidence-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-afternic-listing-write-vectors.mjs && node /tmp/gooddealer-afternic-listing-write-vectors.mjs",
    "generate:afternic-listing-plan-approval-vectors": "esbuild scripts/generate-afternic-listing-plan-approval-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-afternic-listing-plan-vectors.mjs && node /tmp/gooddealer-afternic-listing-plan-vectors.mjs",
    "generate:sellerhub-bin-price-vectors": "esbuild scripts/generate-sellerhub-bin-price-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-sellerhub-bin-price-vectors.mjs && node /tmp/gooddealer-sellerhub-bin-price-vectors.mjs",
    "generate:sellerhub-create-listing-vectors": "esbuild scripts/generate-sellerhub-create-listing-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-sellerhub-create-listing-vectors.mjs && node /tmp/gooddealer-sellerhub-create-listing-vectors.mjs",
    "generate:atom-standard-delist-vectors": "esbuild scripts/generate-atom-standard-delist-vectors.ts --bundle --platform=node --format=esm --outfile=/tmp/gooddealer-atom-standard-delist-vectors.mjs && node /tmp/gooddealer-atom-standard-delist-vectors.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
