# Copy this file to .env.local and replace all six local-only passwords.
# Keep the canonical database and role names unless an explicitly named
# isolation profile is required for concurrent destructive work.
GOODDEALER_POSTGRES_OWNER_URL=postgresql://gooddealer_cloud_owner:replace-local-owner-password@localhost:5432/gooddealer_test
GOODDEALER_POSTGRES_APP_URL=postgresql://gooddealer_cloud_app:replace-local-app-password@localhost:5432/gooddealer_test
GOODDEALER_POSTGRES_ACCOUNT_API_URL=postgresql://gd_account_api:replace-local-account-api-password@localhost:5432/gooddealer_test
GOODDEALER_POSTGRES_IDENTITY_ISSUER_URL=postgresql://gd_identity_capability_issuer:replace-local-identity-issuer-password@localhost:5432/gooddealer_test
GOODDEALER_POSTGRES_PROVIDER_INGRESS_URL=postgresql://gd_provider_ingress:replace-local-provider-ingress-password@localhost:5432/gooddealer_test
GOODDEALER_POSTGRES_PROVIDER_WORKER_URL=postgresql://gd_provider_worker:replace-local-provider-worker-password@localhost:5432/gooddealer_test

# Optional local authorization profile overrides. AppRole credentials remain in the referenced
# mode-0600 file and are never copied into this environment file.
GOODDEALER_OPENBAO_PUBLIC_KEYS_FILE=/absolute/path/to/openbao-dev/public-keys.json
GOODDEALER_OPENBAO_APPROLE_FILE=/absolute/path/to/openbao-dev/authority-approle.json
GOODDEALER_OPENBAO_REQUIRED_POLICY=gooddealer-dev-authority
GOODDEALER_CLOUD_DEVELOPMENT_HOST=127.0.0.1
GOODDEALER_CLOUD_DEVELOPMENT_PORT=3000

# Identity account-access development profile. Both secret values are independent 32-byte
# base64url strings without padding. Mailpit must be started explicitly on loopback; production
# email delivery is not enabled by these settings.
GOODDEALER_IDENTITY_VERIFICATION_PEPPER=replace-with-32-byte-base64url-value
GOODDEALER_IDENTITY_OUTBOX_KEY=replace-with-different-32-byte-base64url-value
GOODDEALER_IDENTITY_BROWSER_NAMESPACE_KEY=replace-with-another-32-byte-base64url-value
GOODDEALER_WORKSPACE_SYNC_TOKEN_KEY=replace-with-a-fourth-32-byte-base64url-value
GOODDEALER_IDENTITY_OUTBOX_KEY_ID=development-v1
GOODDEALER_IDENTITY_FROM_EMAIL=account@development.gooddealer.invalid
GOODDEALER_ACCOUNT_ORIGIN=https://account.gooddealer.com
GOODDEALER_IDENTITY_DEVELOPMENT_HOST=127.0.0.1
GOODDEALER_IDENTITY_DEVELOPMENT_PORT=3001
GOODDEALER_MAILPIT_SMTP_PORT=1025

# Root-managed, mode-0640 deployment file. It contains the Stripe test API key and webhook secret;
# never commit its contents. The provider worker reads the same file but only from its service account.
GOODDEALER_COMMERCIAL_PROVIDER_FILE=/absolute/path/to/commercial-development.json
GOODDEALER_PROVIDER_WORKER_INTERVAL_MS=5000
GOODDEALER_PROVIDER_WORKER_MAX_DRAIN=100
