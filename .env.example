# Copy this file to .env.local and replace both local-only passwords.
# Keep the canonical database and role names unless an explicitly named
# isolation profile is required for concurrent destructive work.
GOODDEALER_POSTGRES_OWNER_URL=postgresql://gooddealer_cloud_owner:replace-local-owner-password@localhost:5432/gooddealer_test
GOODDEALER_POSTGRES_APP_URL=postgresql://gooddealer_cloud_app:replace-local-app-password@localhost:5432/gooddealer_test
