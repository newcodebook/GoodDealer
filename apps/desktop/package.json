{
  "name": "@gooddealer/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "icon:generate": "tauri icon ../../packages/ui/src/assets/logo/mark.svg --output src-tauri/icons --ios-color '#0A0B0F'",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json",
    "visual:build": "vite build --config vite.visual.config.ts",
    "visual:test": "vitest run visual-fixtures",
    "visual:typecheck": "tsc -p visual-fixtures/tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@gooddealer/client-core": "workspace:*",
    "@gooddealer/i18n": "workspace:*",
    "@gooddealer/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "vite": "8.2.2"
  }
}
