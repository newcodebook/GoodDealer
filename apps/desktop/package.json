{
  "name": "@gooddealer/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "icon:generate": "tauri icon ../../packages/ui/src/assets/logo/mark.svg --output src-tauri/icons --ios-color '#0A0B0F'",
    "test": "vitest run src visual-fixtures",
    "typecheck": "tsc -p tsconfig.json && tsc -p visual-fixtures/tsconfig.json",
    "tauri": "tauri",
    "visual:dev": "vite --config vite.visual.config.ts",
    "visual:build": "vite build --config vite.visual.config.ts"
  },
  "dependencies": {
    "@gooddealer/client-core": "workspace:*",
    "@gooddealer/i18n": "workspace:*",
    "@gooddealer/ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5"
  }
}
