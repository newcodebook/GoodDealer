{
  "name": "gooddealer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "generate:secure-host": "node scripts/generate-endpoint-registry.mjs",
    "check:generated": "node scripts/generate-endpoint-registry.mjs --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:rust": "cargo test --workspace --all-targets",
    "test:structure": "node --test scripts/*.test.mjs && node scripts/check-workspace.mjs && node scripts/check-boundaries.mjs",
    "check:platform-neutral": "pnpm check:generated && pnpm typecheck && pnpm test && pnpm test:structure",
    "check": "pnpm check:platform-neutral && pnpm test:rust",
    "gate:validate": "node scripts/validate-gate-closure-attestation.mjs",
    "evidence:wp0": "node scripts/collect-wp0-evidence.mjs",
    "evidence:wp1": "node scripts/collect-wp0-evidence.mjs --slice keychain",
    "evidence:wp2": "node scripts/collect-wp0-evidence.mjs --slice account-gate",
    "evidence:wp4": "node scripts/collect-wp0-evidence.mjs --slice cloud-boundary",
    "evidence:wp5": "node scripts/collect-wp0-evidence.mjs --slice sqlcipher",
    "evidence:wp5:bundle": "node scripts/collect-wp0-evidence.mjs --slice sqlcipher-bundle"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
